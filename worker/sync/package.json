{
  "name": "@roboref/worker-sync",
  "version": "1.0.0",
  "description": "Sync Service for RoboRef",
  "scripts": {
    "dev": "wrangler dev --config ../../wrangler.toml --ip 0.0.0.0 --env test",
    "dev:remote": "wrangler dev --config ../../wrangler.toml --remote --env test",
    "build": "wrangler deploy --config ../../wrangler.toml --env test --dry-run",
    "deploy": "wrangler deploy --config ../../wrangler.toml --env live",
    "deploy:test": "wrangler deploy --config ../../wrangler.toml --env test",
    "deploy:live": "wrangler deploy --config ../../wrangler.toml --env live",
    "format": "prettier --write  '*.{json,js}' 'src/**/*.{js,ts}'",
    "lint": "eslint --max-warnings=0 src && prettier --check '*.{json,js}' 'src/**/*.{js,ts}'"
  },
  "author": "Brendan McGuire",
  "license": "ISC",
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@roboref/consistency": "file:../../lib/consistency",
    "@roboref/pdf-export": "file:../../lib/pdf",
    "@roboref/vexevents": "file:../../lib/vexevents",
    "@roboref/share": "file:../../lib/share",
    "cloudflare": "^7.0.0",
    "iso-3166-1": "^2.1.1",
    "itty-router": "^5.0.24"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "prettier": "^3.9.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.112.0"
  }
}