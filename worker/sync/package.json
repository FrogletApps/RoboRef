{
  "name": "@referee-fyi/worker-sync",
  "version": "1.0.0",
  "description": "Sync Service for Referee FYI",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --env test",
    "dev:remote": "wrangler dev --remote --env test",
    "dev:secure": "sudo wrangler dev --ip 0.0.0.0 --env test --local-protocol https --https-key-path ../../.certs/privkey.pem --https-cert-path ../../.certs/cert.pem",
    "build": "wrangler deploy --env test --dry-run",
    "deploy": "wrangler deploy --env live",
    "deploy:test": "wrangler deploy --env test",
    "deploy:live": "wrangler deploy --env live",
    "format": "prettier --write  '*.{json,js}' 'src/**/*.{js,ts}'",
    "lint": "eslint --max-warnings=0 src && prettier --check '*.{json,js}' 'src/**/*.{js,ts}'"
  },
  "author": "Brendan McGuire",
  "license": "ISC",
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@referee-fyi/consistency": "file:../../lib/consistency",
    "@referee-fyi/pdf-export": "file:../../lib/pdf",
    "@referee-fyi/robotevents": "file:../../lib/robotevents",
    "@referee-fyi/share": "file:../../lib/share",
    "cloudflare": "^6.4.0",
    "iso-3166-1": "^2.1.1",
    "itty-router": "^5.0.24"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "prettier": "^3.9.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.112.0"
  }
}