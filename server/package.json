{
  "name": "roboref-sync-server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Universal sync server for RoboRef deployable to Cloudflare Workers and Raspberry Pi",
  "main": "src/index.node.ts",
  "scripts": {
    "dev:cf": "wrangler dev -c ../wrangler.toml",
    "deploy:cf:test": "wrangler deploy -c ../wrangler.toml --env test",
    "deploy:cf:live": "wrangler deploy -c ../wrangler.toml --env live",
    "dev:node": "tsx watch src/index.node.ts",
    "start:node": "tsx src/index.node.ts",
    "build:node": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/node-ws": "^1.3.1",
    "dotenv": "^16.4.7",
    "hono": "^4.13.4",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.17.19": true,
    "workerd@1.20250718.0": true
  }
}
