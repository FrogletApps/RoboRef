# Explicitly pass through static asset paths so missing or in-flight assets return 404
# instead of rewriting to index.html with a 200 status code.
# This prevents browsers and CDNs from ever caching index.html as a JS/CSS module.
/assets/* /assets/:splat 200
/icons/* /icons/:splat 200
/rules/* /rules/:splat 200
/screenshots/* /screenshots/:splat 200
/sw.js /sw.js 200
/registerSW.js /registerSW.js 200
/version.json /version.json 200
/manifest.webmanifest /manifest.webmanifest 200
/robots.txt /robots.txt 200
/sitemap.xml /sitemap.xml 200
/llms.txt /llms.txt 200

# Catch-all rewrite for SPA client-side routing
/* /index.html 200

